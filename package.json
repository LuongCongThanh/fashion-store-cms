{
  "name": "fashion-store-cms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "pwa:assets": "pwa-assets-generator",
    "knip": "knip",
    "analyze": "vite build --mode analyze",
    "gen:api": "tsx scripts/GenApi.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@faker-js/faker": "^10.6.0",
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.65.0",
    "@tanstack/vue-query-devtools": "^6.4.1",
    "@types/node": "^22.20.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@iconify-json/lucide": "^1.2.152",
    "@nuxt/ui": "^4.12.0",
    "@tanstack/vue-query": "^5.107.1",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.0",
    "echarts": "^6.1.0",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.45",
    "vue-echarts": "^8.3.2",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  }
}
