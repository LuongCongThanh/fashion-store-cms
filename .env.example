# Copy thành .env.local rồi sửa giá trị.
# Gốc URL API backend. Local dùng Vite proxy; production dùng reverse proxy cùng origin.
VITE_API_BASE_URL=/api/v1

# Chỉ dùng cho script gen:api (không có tiền tố VITE_, không expose ra browser).
OPENAPI_URL=https://github.com/LuongCongThanh/be-demo/releases/download/openapi-v0.1.0/openapi.json
