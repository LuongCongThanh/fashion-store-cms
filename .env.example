# Copy thành .env.local rồi sửa giá trị.
# Gốc URL API backend.
VITE_API_BASE_URL=http://localhost:8080/api

# Chỉ dùng cho script gen:api (không có tiền tố VITE_, không expose ra browser).
OPENAPI_URL=http://localhost:8080/v3/api-docs

# 'true' → Mock auth khi chạy DEV (tài khoản admin@cms.local / admin123). Không có tác dụng ở production.
VITE_MOCK_AUTH=false
